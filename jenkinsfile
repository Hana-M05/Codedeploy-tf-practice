pipeline {
    agent any
    parameters {
        string(name: 'TARGET_VERSION', defaultValue: '2.0', description: 'Enter Version to Deploy')
    }
    stages {
        stage('Trigger Deployment') {
            steps {
                script {
                     withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                ]) {
                    // 1. Generate an automatic version name (e.g., "Build #12")
                    def autoVersion = "#${env.BUILD_NUMBER}"
                    
                    // 2. Update the Version in AWS Parameter Store
                    // We use the autoVersion variable instead of params.TARGET_VERSION
                    sh "aws ssm put-parameter --name '/app/version' --value '${autoVersion}' --type 'String' --overwrite --region us-west-2"
                    
                    // 3. Trigger CodeDeploy
                    sh """
                    aws deploy create-deployment \
                        --application-name Htest-web-app \
                        --deployment-group-name Htest-deployment-group \
                        --github-location repository=Hana-M05/Codedeploy-tf-practice,commitId=${GIT_COMMIT} \
                        --region us-west-2 \
                        --file-exists-behavior OVERWRITE
                    """
                  }
                }
            }
        }
    }
}