pipeline {
    agent any
    parameters {
        string(name: 'TARGET_VERSION', defaultValue: '2.0', description: 'Enter Version to Deploy')
    }
    stages {
        stage('Trigger Deployment') {
            steps {
                script {
                    // This command tells CodeDeploy to pull from GitHub 
                    // AND passes the version as an environment variable
                    sh """
                    aws deploy create-deployment \
                        --application-name Htest-web-app \
                        --deployment-group-name Htest-deployment-group \
                        --github-location repository=${https://github.com/Hana-M05/Codedeploy-tf-practice},commitId=${4d2c30d50b1ee7c68774c88ec545ededb9980922} \
                        --update-outdated-instances-only
                    """
                }
            }
            }
            
    }
    }